# Environment Variables Template
# Copy this file to .env and fill in your API keys. NEVER commit .env to version control!

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration (Mistral API)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Speech-to-Text Configuration (Google Web Speech API — FREE, no API key needed)
STT_LANGUAGE=en-US

# Vector Database Configuration
CHROMA_PERSIST_DIR=./data/chroma_db

# File Upload Limits
MAX_AUDIO_SIZE_MB=25
ALLOWED_AUDIO_FORMATS=["audio/wav","audio/mpeg","audio/mp3","audio/m4a","audio/x-m4a","audio/webm"]
